%% FamilyPassportMap — Master Entity-Relationship Diagram
%% This is the single source of truth for the database schema. It must always match
%% apps/server/prisma/schema.prisma exactly — see CLAUDE.md's "Diagram Sync Requirements".
%% Implemented as of v2.5.0 / Phase 13 (migrations 20260812220505_add_person_and_visited_state,
%% 20260916173026_add_visited_country, 20261019212746_add_user_and_session,
%% 20261020153324_add_person_owner, 20261020172320_add_primary_person,
%% 20261120144524_add_sign_in_methods).

erDiagram
    PERSON ||--o{ VISITED_STATE : "visits"
    PERSON ||--o{ VISITED_COUNTRY : "visits"
    USER ||--o{ SESSION : "signed in as"
    USER ||--o{ SIGN_IN_METHOD : "signs in with"
    USER ||--o{ PASSKEY : "signs in with"
    USER |o--o{ PERSON : "owns"
    USER |o--o| PERSON : "is (Primary Person)"

    PERSON {
        string id PK "cuid"
        string ownerId FK "nullable, -> User.id, onDelete Cascade; null only for pre-login People"
        string name
        string colorHex "validated hex color"
        string profilePicturePath "nullable, DATA_DIR/uploads/..."
        datetime createdAt
    }

    VISITED_STATE {
        string id PK "cuid"
        string personId FK "-> Person.id, onDelete Cascade"
        string stateCode "2-letter USPS code, e.g. CA"
        datetime visitedAt
    }

    VISITED_COUNTRY {
        string id PK "cuid"
        string personId FK "-> Person.id, onDelete Cascade"
        string countryCode "ISO 3166-1 alpha-2, e.g. FR"
        datetime visitedAt
    }

    USER {
        string id PK "cuid"
        string email "nullable (passkey-only account), display only"
        string displayName "empty until a provider name or the welcome step"
        string avatarUrl "nullable, last provider's picture URL"
        string primaryPersonId FK "nullable, unique, -> Person.id, onDelete SetNull"
        datetime createdAt
    }

    SESSION {
        string id PK "SHA-256 hex of the cookie token"
        string userId FK "-> User.id, onDelete Cascade"
        datetime expiresAt "slides forward with use"
        datetime createdAt
    }

    SIGN_IN_METHOD {
        string id PK "cuid"
        string userId FK "-> User.id, onDelete Cascade"
        string kind "microsoft | google | github"
        string subject "provider's stable user id"
        string email "nullable, shown on the Sign-in methods page"
        datetime createdAt
        datetime lastUsedAt
    }

    PASSKEY {
        string id PK "cuid"
        string userId FK "-> User.id, onDelete Cascade"
        string credentialId "unique, base64url"
        bytes publicKey "COSE public key; no private key is ever stored"
        int signCount
        string transports "nullable, JSON array"
        string name "1-40 characters"
        datetime createdAt
        datetime lastUsedAt
    }

    %% SIGN_IN_METHOD (kind, subject) is unique — a sign-in method belongs to exactly one User;
    %% accounts are never merged. PASSKEY.credentialId is unique. SIGN_IN_METHOD.userId and
    %% PASSKEY.userId are indexed.
    %% USER.primaryPersonId is unique (one User per Person) and null only before the welcome
    %% step; deleting that Person sets it back to null.
    %% Deleting a User cascade-deletes their Sessions, Sign-in methods, Passkeys, and the
    %% People they own (and so those
    %% People's visits). PERSON.ownerId and SESSION.userId are indexed.
    %% Unique constraints: VISITED_STATE (personId, stateCode) and
    %% VISITED_COUNTRY (personId, countryCode) — a person can only have one row per
    %% state, and one row per country.
    %% Deleting a Person cascade-deletes both their VisitedState and VisitedCountry rows.
    %% VISITED_STATE and VISITED_COUNTRY are fully independent — no relation between them,
    %% and marking the US as a visited country has no link to any visited states.
