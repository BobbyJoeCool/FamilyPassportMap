// FamilyPassportMap database schema.
// Whenever a model, field, relation, or constraint changes here, update
// docs/diagrams/ERD.mmd in the same change — see CLAUDE.md's Diagram Sync Requirements.
//
// The datasource URL is NOT set here — Prisma 7 reads it from prisma.config.ts
// (which loads DATABASE_URL from .env). Connecting also requires an explicit driver
// adapter (@prisma/adapter-better-sqlite3) when instantiating PrismaClient — Prisma 7
// removed the old "just works" bundled query engine. See prisma.config.ts and
// docs/Phase-1-Data-Layer-People.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Person {
  id                 String           @id @default(cuid())
  // The User this Person belongs to (Phase 12). Nullable ONLY for Legacy People (recorded
  // before login) until they're Adopted; every new Person is created with an Owner.
  ownerId            String?
  owner              User?            @relation("PersonOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  colorHex           String
  profilePicturePath String?
  createdAt          DateTime         @default(now())
  visitedStates      VisitedState[]
  visitedCountries   VisitedCountry[]
  // The User this Person IS (their Primary Person), if any. Back-relation only.
  primaryOf          User?            @relation("PrimaryPerson")

  @@index([ownerId])
}

model VisitedState {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  stateCode String // 2-letter USPS code, e.g. "CA"
  visitedAt DateTime @default(now())

  @@unique([personId, stateCode])
}

// Country visits are deliberately a separate, parallel model to VisitedState rather than a
// shared "visited place" table — country tracking and state tracking are fully independent
// features that share nothing but Person. See docs/Phase-8-World-Data-Layer.md.
model VisitedCountry {
  id          String   @id @default(cuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  countryCode String // ISO 3166-1 alpha-2 code, e.g. "FR"
  visitedAt   DateTime @default(now())

  @@unique([personId, countryCode])
}

// Someone who signs in (Phase 12). Since Phase 13 a User signs in with one or more Sign-in
// methods (SignInMethod, Passkey) instead of one provider id stored here. email, displayName and
// avatarUrl are display values only, refreshed from whichever provider was just used. email is
// null for an account with no email (passkey-only); displayName is "" until a provider gives a
// name or the welcome step sets it from the Primary Person.
model User {
  id              String         @id @default(cuid())
  email           String?
  displayName     String
  avatarUrl       String? // the last provider's profile-picture URL, shown in the header (Microsoft sends none)
  // The Person who IS this User. Null only between first sign-in and finishing the welcome
  // step. Set back to null if that Person is ever deleted (in practice only Claim replaces it).
  primaryPersonId String?        @unique
  primaryPerson   Person?        @relation("PrimaryPerson", fields: [primaryPersonId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  sessions        Session[]
  people          Person[]       @relation("PersonOwner")
  signInMethods   SignInMethod[]
  passkeys        Passkey[]
}

// One way a User signs in with an outside identity: a Microsoft, Google or GitHub account
// (Phase 13). The unique (kind, subject) is what makes a
// Sign-in method belong to exactly one User: accounts are never merged.
model SignInMethod {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String // "microsoft" | "google" | "github"
  // The provider's stable user id.
  subject    String
  // The account's email, shown on the Sign-in methods page. Null if the provider gave none.
  email      String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@unique([kind, subject])
  @@index([userId])
}

// A passkey (WebAuthn credential) a User signs in with (Phase 13). Kept apart from SignInMethod
// because it carries key material. Only the public key is ever stored.
model Passkey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique // base64url
  publicKey    Bytes
  signCount    Int
  transports   String? // JSON array of the authenticator's transports, e.g. ["internal","hybrid"]
  name         String
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([userId])
}

// A signed-in browser. The cookie carries a random token; only its SHA-256 hash is stored
// here, so a leaked database can't be used to sign in. Expiry slides forward with use.
model Session {
  id        String   @id // SHA-256 hex of the cookie token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
