// FamilyPassportMap database schema.
// Whenever a model, field, relation, or constraint changes here, update
// Documentation/diagrams/ERD.mmd in the same change — see CLAUDE.md's Diagram Sync Requirements.
//
// The datasource URL is NOT set here — Prisma 7 reads it from prisma.config.ts
// (which loads DATABASE_URL from .env). Connecting also requires an explicit driver
// adapter (@prisma/adapter-better-sqlite3) when instantiating PrismaClient — Prisma 7
// removed the old "just works" bundled query engine. See prisma.config.ts and
// Documentation/Phase-1-Data-Layer-People.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Person {
  id                 String           @id @default(cuid())
  // The User this Person belongs to (Phase 12). Nullable ONLY for Legacy People (recorded
  // before login) until they're Adopted; every new Person is created with an Owner.
  ownerId            String?
  owner              User?            @relation("PersonOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  colorHex           String
  profilePicturePath String?
  createdAt          DateTime         @default(now())
  visitedStates      VisitedState[]
  visitedCountries   VisitedCountry[]
  // The User this Person IS (their Primary Person), if any. Back-relation only.
  primaryOf          User?            @relation("PrimaryPerson")

  @@index([ownerId])
}

model VisitedState {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  stateCode String // 2-letter USPS code, e.g. "CA"
  visitedAt DateTime @default(now())

  @@unique([personId, stateCode])
}

// Country visits are deliberately a separate, parallel model to VisitedState rather than a
// shared "visited place" table — country tracking and state tracking are fully independent
// features that share nothing but Person. See Documentation/Phase-8-World-Data-Layer.md.
model VisitedCountry {
  id          String   @id @default(cuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  countryCode String // ISO 3166-1 alpha-2 code, e.g. "FR"
  visitedAt   DateTime @default(now())

  @@unique([personId, countryCode])
}

// Someone who signs in (Phase 12). Keyed by sign-in provider + that provider's stable user id,
// so adding another provider later needs no data change. email/displayName/avatarUrl are
// refreshed from the provider on every sign-in.
model User {
  id              String    @id @default(cuid())
  authProvider    String // "google"
  authSubject     String // the provider's user id (Google's "sub")
  email           String
  displayName     String
  avatarUrl       String? // provider's profile-picture URL; shown in the header only
  // The Person who IS this User. Null only between first sign-in and finishing the welcome
  // step. Set back to null if that Person is ever deleted (in practice only Claim replaces it).
  primaryPersonId String?   @unique
  primaryPerson   Person?   @relation("PrimaryPerson", fields: [primaryPersonId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  sessions        Session[]
  people          Person[]  @relation("PersonOwner")

  @@unique([authProvider, authSubject])
}

// A signed-in browser. The cookie carries a random token; only its SHA-256 hash is stored
// here, so a leaked database can't be used to sign in. Expiry slides forward with use.
model Session {
  id        String   @id // SHA-256 hex of the cookie token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
