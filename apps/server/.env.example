# Copy this file to .env and adjust if needed. .env is gitignored; this template is not.

# Directory (relative to apps/server) where local, persistent app data lives:
# the SQLite database file, and (from Phase 1 onward) uploaded profile pictures.
# In production on Azure (Phase 6), this is set to a path under the persistent
# /home directory instead, e.g. /home/data.
DATA_DIR=./data

# Prisma's SQLite connection string, read by prisma.config.ts (not by schema.prisma
# directly — see the comment there). Relative "file:" paths resolve relative to
# apps/server's root (where prisma.config.ts lives), same as DATA_DIR above, so this
# stays pointed at ${DATA_DIR}/app.db. If DATA_DIR changes, update this to match.
DATABASE_URL="file:./data/app.db"

# Microsoft sign-in (Phase 12). Register an app in Microsoft Entra ID (any organizational
# directory and personal Microsoft accounts) with the Web redirect URI
# ${APP_BASE_URL}/api/auth/microsoft/callback. Locally that's
# http://localhost:5173/api/auth/microsoft/callback (through the Vite dev proxy). The secret is the
# client secret's Value, and it expires. Tests don't need these; production refuses to start
# without them. See Documentation/AZURE-SETUP.md, step 6.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# The address people open the app at; used to build Microsoft's redirect URI.
APP_BASE_URL=http://localhost:5173

# The site owner's personal Microsoft account email (case-insensitive; work or school accounts
# never qualify). When they sign in, they Adopt every Person
# recorded before login (People with no Owner), so the original family's data isn't lost.
# Leave empty and nobody Adopts them: they stay invisible to everyone.
LEGACY_DATA_OWNER_EMAIL=
