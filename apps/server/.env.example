# Copy this file to .env and adjust if needed. .env is gitignored; this template is not.

# Directory (relative to apps/server) where local, persistent app data lives:
# the SQLite database file, and (from Phase 1 onward) uploaded profile pictures.
# In production on Azure (Phase 6), this is set to a path under the persistent
# /home directory instead, e.g. /home/data.
DATA_DIR=./data

# Prisma's SQLite connection string, read by prisma.config.ts (not by schema.prisma
# directly — see the comment there). Relative "file:" paths resolve relative to
# apps/server's root (where prisma.config.ts lives), same as DATA_DIR above, so this
# stays pointed at ${DATA_DIR}/app.db. If DATA_DIR changes, update this to match.
DATABASE_URL="file:./data/app.db"

# --- Sign-in (Phases 12-13) ---------------------------------------------------------------------
# The address people open the app at. Every provider's redirect URI is built from it
# (${APP_BASE_URL}/api/auth/<provider>/callback), and it's the passkey domain (its hostname).
# Locally that's the Vite dev server, which forwards /api to this server.
APP_BASE_URL=http://localhost:5173

# Each provider is offered only when BOTH its client id and secret are set. Production refuses to
# start unless at least one provider (or email codes) is set up. Tests and E2E runs need none of these.

# Microsoft (Entra ID app registration: any organizational directory + personal accounts). Redirect
# URI: http://localhost:5173/api/auth/microsoft/callback. The secret is the client secret's Value,
# and it expires: note the date.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web
# application"). Redirect URI: http://localhost:5173/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub (Settings > Developer settings > OAuth Apps). One callback URL per app, so local development
# uses its own app with callback http://localhost:5173/api/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email codes: offered only when ALL five are set. Any SMTP mail service works. Port 587 (STARTTLS,
# required) or 465 (TLS). MAIL_FROM is the sender address people see, e.g.
# "FamilyPassportMap <no-reply@bobbyjoecool.dev>"; the mail service must be allowed to send as it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Passkeys need no settings: they work whenever the page is https (or localhost).

# The site owner's personal Microsoft account email (case-insensitive; work or school accounts
# never qualify). When they sign in, they Adopt every Person
# recorded before login (People with no Owner), so the original family's data isn't lost.
# Leave empty and nobody Adopts them: they stay invisible to everyone.
LEGACY_DATA_OWNER_EMAIL=
